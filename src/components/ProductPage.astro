---
// Tek ürün türü sayfası şablonu — TR/EN/DE ortak.
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import ParallaxBand from './ParallaxBand.astro';
import Icon from './Icon.astro';
import Breadcrumb from './Breadcrumb.astro';
import RelatedLinks from './RelatedLinks.astro';
import { company, sectors, sectorDetail } from '../data/site';
import { productTypes } from '../data/products';

const { p, lang = 'tr' } = Astro.props;
const base = lang === 'tr' ? '' : '/' + lang;
const path = `${base}/urunler/${p.slug}/`;
const t = {
  tr: { products:'Ürünler', spec:'Teknik Özellikler', gallery:'Görseller', use:'Kullanıldığı sektörler', faq:'Sıkça sorulanlar', other:'Diğer ürün türleri',
        ctaH:'Bu ürün için teklif alın', ctaP:'Ölçü, sertlik (Shore A) ve kaplama tipini iletin; uygun çözümü birlikte belirleyelim.', quote:'Teklif Formu', all:'Tüm ürünler', prop:'Özellik', val:'Değer' },
  en: { products:'Products', spec:'Technical specifications', gallery:'Images', use:'Industries served', faq:'FAQ', other:'Other product types',
        ctaH:'Request a quote for this product', ctaP:'Share dimensions, hardness (Shore A) and covering type; we will define the right solution together.', quote:'Quote form', all:'All products', prop:'Property', val:'Value' },
  de: { products:'Produkte', spec:'Technische Daten', gallery:'Bilder', use:'Belieferte Branchen', faq:'Häufige Fragen', other:'Weitere Produkttypen',
        ctaH:'Angebot für dieses Produkt', ctaP:'Teilen Sie Maße, Härte (Shore A) und Beschichtungsart mit; wir definieren gemeinsam die passende Lösung.', quote:'Angebotsformular', all:'Alle Produkte', prop:'Merkmal', val:'Wert' },
  ru: { products:'Продукция', spec:'Технические характеристики', gallery:'Изображения', use:'Обслуживаемые отрасли', faq:'Частые вопросы', other:'Другие типы продукции',
        ctaH:'Запросите цену на этот продукт', ctaP:'Сообщите размеры, твёрдость (Shore A) и тип покрытия; подходящее решение определим вместе.', quote:'Форма запроса', all:'Вся продукция', prop:'Характеристика', val:'Значение' },
  ar: { products:'المنتجات', spec:'المواصفات الفنية', gallery:'الصور', use:'القطاعات المخدومة', faq:'الأسئلة الشائعة', other:'أنواع منتجات أخرى',
        ctaH:'اطلبوا عرض سعر لهذا المنتج', ctaP:'أرسلوا المقاس والصلادة (شور A) ونوع التكسية؛ ولنحدّد الحل المناسب معًا.', quote:'نموذج طلب عرض سعر', all:'كل المنتجات', prop:'الخاصية', val:'القيمة' },
}[lang];

const sectorLabel = (trName) => (sectors.find(s => s.tr === trName) || {})[lang] || trName;

// Her ürün detay sayfası benzersiz description almalı — daha önce hepsi site varsayılanına düşüyordu.
const descTail = {
  tr: `${p.brand} üretimi. Ø1200 × 7000 mm’e kadar kaplama, çalışma şartına özel Shore A, ST52 çelik çekirdek, 3 ay garanti.`,
  en: `Manufactured by ${p.brand}. Covering up to Ø1200 × 7000 mm, Shore A to your operating conditions, ST52 steel core, 3-month warranty.`,
  de: `Gefertigt von ${p.brand}. Beschichtung bis Ø1200 × 7000 mm, Shore A nach Betriebsbedingungen, ST52-Stahlkern, 3 Monate Garantie.`,
  ru: `Производство ${p.brand}. Покрытие до Ø1200 × 7000 мм, Shore A под ваши условия работы, стальной сердечник ST52, гарантия 3 месяца.`,
  ar: `من إنتاج ${p.brand}. تكسية حتى Ø1200 × 7000 مم، وصلادة شور A حسب ظروف التشغيل، وقلب فولاذي ST52، وضمان 3 أشهر.`,
}[lang];
const metaDesc = `${p.name[lang]}: ${p.short[lang]}. ${descTail}`.slice(0, 300);
const others = productTypes.filter(x => x.slug !== p.slug).slice(0, 3);
const SITE = (Astro.site ? Astro.site.href : '').replace(/\/$/, '');

const schema = [{
  '@type': 'Product',
  '@id': `${SITE}${path}#product`,
  name: p.name[lang],
  description: p.short[lang],
  image: p.gallery.map(g => `${SITE}${g}`),
  brand: { '@type':'Brand', name: p.brand },
  manufacturer: { '@id': `${SITE}/#organization` },
  material: p.material,
  category: { tr:'Endüstriyel merdane', en:'Industrial roller', de:'Industriewalze', ru:'Промышленный вал', ar:'أسطوانة صناعية' }[lang],
  additionalProperty: p.specs.map(s => ({ '@type':'PropertyValue', name: s[lang], value: s.v[lang] })),
  offers: { '@type':'Offer', availability:'https://schema.org/InStock', priceCurrency:'TRY',
            priceSpecification:{ '@type':'PriceSpecification', valueAddedTaxIncluded:false },
            seller:{ '@id': `${SITE}/#organization` }, url: `${SITE}${path}` },
}];
if (p.faq.length) schema.push({
  '@type':'FAQPage', '@id': `${SITE}${path}#faq`,
  mainEntity: p.faq.map(f => ({ '@type':'Question', name: f.q[lang], acceptedAnswer:{ '@type':'Answer', text: f.a[lang] } })),
});
---
<Base title={`${p.name[lang]} — Merpolon`} lang={lang} path={path} image={p.img} schema={schema} description={metaDesc}>
  <Header lang={lang} seg="urunler/" />
  <Breadcrumb lang={lang} items={[{ href:`${base}/urunler/`, label:t.products }, { href:path, label:p.name[lang] }]} />
  <main id="main" class="bg-white">

    <section class="border-b border-steel-200">
      <div class="mx-auto grid max-w-7xl items-stretch lg:grid-cols-2">
        <div class="flex flex-col justify-center px-6 py-14 lg:py-20 lg:pr-14">
          <p class="flex items-center gap-3 text-xs font-700 uppercase tracking-[0.22em]" style={`color:${p.accent}`}><span class="h-px w-10" style={`background:${p.accent}`}></span>{p.brand}</p>
          <h1 class="mt-5 font-display text-3xl font-800 leading-[1.06] tracking-tight text-navy-900 sm:text-5xl">{p.name[lang]}</h1>
          <p class="mt-5 max-w-lg text-lg leading-relaxed text-navy-500">{p.short[lang]}</p>
          <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
            <a href={`${base}/teklif/`} class="group inline-flex items-center gap-2.5 bg-brand-red px-7 py-4 text-sm font-700 uppercase tracking-wider text-white transition hover:bg-navy-900">{t.quote} <Icon name="arrow" class="h-4 w-4 transition group-hover:translate-x-1"/></a>
            <a href={'tel:'+company.order.replace(/\s/g,'')} class="inline-flex items-center gap-2 border-b-2 border-navy-900 pb-1 text-sm font-700 uppercase tracking-wider text-navy-900 transition hover:border-brand-red hover:text-brand-red">{company.order}</a>
          </div>
        </div>
        <div class="relative min-h-[280px] bg-navy-900 lg:min-h-full">
          <img src={p.img} alt={p.name[lang]} width="1500" height="1000" class="h-full w-full object-cover" />
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 py-16">
      <div class="grid gap-12 lg:grid-cols-[1.3fr_1fr] lg:gap-16">
        <div>
          <p class="text-sm font-700 uppercase tracking-widest text-brand-red">{p.name[lang]}</p>
          <p class="mt-5 text-lg leading-relaxed text-navy-600">{p.body[lang]}</p>
          <h2 class="mt-10 font-display text-xl font-800 text-navy-900">{t.use}</h2>
          <div class="mt-4 flex flex-wrap gap-2">
            {p.sectors.map(s => (<a href={`${base}/sektorler/`} class="border border-steel-300 px-3 py-1.5 text-xs font-600 text-navy-600 transition hover:border-brand-red hover:text-brand-red">{sectorLabel(s)}</a>))}
          </div>
        </div>
        <div>
          <h2 class="font-display text-xl font-800 text-navy-900">{t.spec}</h2>
          <div class="mt-4 overflow-x-auto border border-steel-200">
            <table class="w-full text-left text-sm">
              <thead><tr class="bg-navy-900 text-white"><th scope="col" class="px-4 py-3 font-700">{t.prop}</th><th scope="col" class="px-4 py-3 font-700">{t.val}</th></tr></thead>
              <tbody class="divide-y divide-steel-200 bg-white">
                {p.specs.map(s => (<tr><th scope="row" class="px-4 py-3 text-left font-600 text-navy-500">{s[lang]}</th><td class="px-4 py-3 font-600 text-navy-900">{s.v[lang]}</td></tr>))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <section class="border-y border-steel-200 bg-steel-50">
      <div class="mx-auto max-w-7xl px-6 py-14">
        <h2 class="font-display text-xl font-800 text-navy-900">{t.gallery}</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {p.gallery.map(g => (
            <figure class="overflow-hidden border border-steel-200 bg-white">
              <img src={g} alt={p.name[lang]} loading="lazy" width="1500" height="1000" class="aspect-[4/3] w-full object-cover transition duration-500 hover:scale-105" />
            </figure>
          ))}
        </div>
      </div>
    </section>

    {p.faq.length > 0 && (
      <section class="mx-auto max-w-4xl px-6 py-14">
        <h2 class="font-display text-xl font-800 text-navy-900">{t.faq}</h2>
        <div class="mt-6 border-t border-steel-200">
          {p.faq.map(f => (
            <div class="border-b border-steel-200 py-5">
              <h3 class="font-display text-lg font-700 text-navy-900">{f.q[lang]}</h3>
              <p class="mt-2 leading-relaxed text-navy-600">{f.a[lang]}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <ParallaxBand img="/gallery/celik-cekirdekler.webp" amount="26" overlay="base">
      <div class="mx-auto flex max-w-7xl flex-col items-start gap-8 px-6 py-16 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <h2 class="font-display text-2xl font-800 tracking-tight sm:text-3xl">{t.ctaH}</h2>
          <p class="mt-3 max-w-xl text-steel-300">{t.ctaP}</p>
        </div>
        <div class="flex shrink-0 flex-wrap gap-3">
          <a href={`${base}/teklif/`} class="inline-flex items-center gap-2 bg-brand-red px-6 py-4 text-sm font-700 uppercase tracking-wider transition hover:bg-white hover:text-navy-900">{t.quote}</a>
          <a href={`${base}/urunler/`} class="inline-flex items-center gap-2 border border-white/30 px-6 py-4 text-sm font-700 uppercase tracking-wider transition hover:bg-white/10">{t.all}</a>
        </div>
      </div>
    </ParallaxBand>

    <RelatedLinks lang={lang} title={t.other}
      items={others.map(o => ({ href:`${base}/urunler/${o.slug}/`, label:o.name[lang], desc:o.short[lang] }))} />
  </main>
  <Footer lang={lang} />
</Base>
