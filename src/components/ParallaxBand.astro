---
/*  Arka plan görselli tam genişlik bant — kaydırdıkça görsel yavaş kayar.

    <ParallaxBand img="/gallery/x.webp" amount="26" overlay="strong">
      …içerik…
    </ParallaxBand>

    Görsel kapsayıcıdan %140 uzun (h-[240%], top -70%) — kayma payı buradan gelir.
    Kısıt: amount × 2.4 ≤ 70  →  amount ≤ 29. Varsayılan 26 (kapsayıcı boyunun
    %62,4'ü kadar tek yönlü kayma). Payı aşarsan uçlarda görselin kenarı açılır.  */
const {
  img,
  alt = '',
  amount = 26,
  overlay = 'base',            // 'base' | 'strong' | 'soft'
  class: cls = '',
  id,
} = Astro.props;

const srcset = img
  ? `${img.replace('.webp', '-480.webp')} 480w, ${img.replace('.webp', '-960.webp')} 960w, ${img} 1500w`
  : undefined;

const veil = {
  soft:   'bg-navy-900/60',
  base:   'bg-navy-900/78',
  strong: 'bg-navy-900/88',
}[overlay];
---
<section id={id} data-parallax-host class={`relative isolate overflow-hidden bg-navy-900 text-white ${cls}`}>
  <img
    data-parallax={String(amount)}
    src={img}
    srcset={srcset}
    sizes="100vw"
    alt={alt}
    aria-hidden={alt ? undefined : 'true'}
    width="1500" height="1000" loading="lazy" decoding="async"
    class="pointer-events-none absolute left-0 top-[-70%] -z-10 h-[240%] w-full object-cover"
  />
  <div class={`pointer-events-none absolute inset-0 -z-10 ${veil}`}></div>
  <slot />
</section>
