    relItems:[['/rehber/kaucuk-mu-poliuretan-mi/','مطاط أم بولي يوريثان؟','قارنوا اختيار المادة خطوة بخطوة عبر أربعة أسئلة.'],['/sektorler/','القطاعات','حلول الأسطوانات وملاحظات التطبيق لـ 21 قطاعًا.'],['/hizmetler/','الخدمات','التكسية والجلخ الدقيق وفتح الأخاديد وإعادة التكسية.']],
  },
}[lang];

// TR sektör adı → sektör nesnesi (ürün×sektör matrisi için)
const sectorOf = (trName) => sectors.find(s => s.tr === trName);

const schema = [{
  '@type':'ItemList', '@id': `${SITE}${path}#producttypes`, name: H.typesH,
  itemListElement: productTypes.map((p, i) => ({ '@type':'ListItem', position: i + 1, item: {
    '@type':'Product', '@id': `${SITE}${base}/urunler/${p.slug}/#product`,
    name: p.name[lang], description: p.short[lang], image: `${SITE}${p.img}`,
    url: `${SITE}${base}/urunler/${p.slug}/`,
    brand: { '@type':'Brand', name: p.brand }, manufacturer: { '@id': `${SITE}/#organization` },
  } })),
}];
---
<Base title={H.title} lang={lang} path={path} schema={schema} image="/gallery/grafit-kaucuk-merdaneler.webp">
  <Header lang={lang} seg="urunler/" />
  <main id="main" class="bg-white">
    <PageHero eyebrow={H.eyebrow} title={H.h1} subtitle={H.lede} image="/gallery/grafit-kaucuk-merdaneler.webp" />

    <!-- 1 · ÜRÜN TÜRLERİ (filtrelenebilir) — sayfanın en üstünde -->
    <section class="border-b border-steel-200 bg-white">
      <div class="mx-auto max-w-7xl px-6 py-16">
        <p class="text-sm font-700 uppercase tracking-widest text-brand-red">{H.typesEy}</p>
        <h2 class="mt-3 font-display text-3xl font-800 tracking-tight text-navy-900 sm:text-4xl">{H.typesH}</h2>
        <p class="mt-4 max-w-2xl text-navy-500">{H.typesP}</p>

        <div id="pfilters" class="mt-8 flex gap-2 overflow-x-auto pb-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden lg:flex-wrap">
          {H.filters.map(([k, l], i) => (
            <button type="button" data-pf={k} aria-pressed={i === 0 ? 'true' : 'false'}
              class="shrink-0 whitespace-nowrap border border-steel-300 px-4 py-2 min-h-11 text-xs font-700 uppercase tracking-wider text-navy-600 transition aria-pressed:border-navy-900 aria-pressed:bg-navy-900 aria-pressed:text-white hover:border-navy-900">{l}</button>
          ))}
        </div>

        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {productTypes.map(p => (
            <a href={`${base}/urunler/${p.slug}/`} data-pgroup={GROUP[p.slug]}
               class="group flex flex-col border border-steel-200 bg-white transition hover:border-brand-red/40">
              <div class="relative">
                <img src={p.img} alt={p.name[lang]} loading="lazy" width="1500" height="1000" class="aspect-[4/3] w-full object-cover" />
                <span class="absolute left-0 top-0 bg-navy-900/90 px-2.5 py-1 text-[11px] font-700 uppercase tracking-wider text-white">{H.mat[p.material]}</span>
              </div>
              <div class="flex flex-1 flex-col p-5">
                <h3 class="font-display text-base font-700 text-navy-900 group-hover:text-brand-red">{p.name[lang]}</h3>
                <p class="mt-1.5 flex-1 text-sm leading-relaxed text-navy-500">{p.short[lang]}</p>
                <span class="mt-3 inline-flex items-center gap-2 text-xs font-700 uppercase tracking-wider text-navy-900 group-hover:text-brand-red">{H.review} <Icon name="arrow" class="h-4 w-4 transition group-hover:translate-x-1"/></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 2 · MARKA HATLARI -->
    <section class="border-b border-steel-200 bg-steel-50">
      <div class="mx-auto max-w-7xl px-6 py-16">
        <p class="text-sm font-700 uppercase tracking-widest text-brand-red">{H.linesEy}</p>
        <h2 class="mt-3 font-display text-3xl font-800 tracking-tight text-navy-900 sm:text-4xl">{H.linesH}</h2>
        <div class="mt-12 space-y-12" data-reveal-group>
          {productLines.map((p, i) => (
            <article data-reveal class="grid items-center gap-10 lg:grid-cols-2" id={p.slug}>
              <div class={i % 2 ? 'lg:order-2' : ''}>
                <div class="overflow-hidden border border-steel-200"><img src={p.img} alt={p.name[lang]} loading="lazy" width="1500" height="1000" class="aspect-[4/3] w-full object-cover"/></div>
              </div>
              <div>
                <span class="inline-block px-3 py-1 text-xs font-700 uppercase tracking-wider text-white" style={`background:${p.accent}`}>{p.name[lang].split('—')[0].trim()}</span>
                <h3 class="mt-4 font-display text-2xl font-800 text-navy-900">{p.name[lang]}</h3>
                <p class="mt-1 text-sm font-600" style={`color:${p.accent}`}>{p.tagline[lang]}</p>
                <p class="mt-4 leading-relaxed text-navy-500">{p.body[lang]}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 3 · SEYDEL TİP TABLOSU -->
