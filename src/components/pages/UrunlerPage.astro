    lede:'علامتان ومعيار جودة واحد؛ تُنتَج بالصلادة والقطر والطول التي تتطلبها ظروف تشغيلكم. وفيما يلي جميع أنواع الأسطوانات لدينا والجداول الفنية وأي منتج يناسب أي خط.',
    typesEy:'أنواع المنتجات', typesH:'جميع أنواع الأسطوانات لدينا', typesP:'لكل نوع من الأنواع الثمانية صفحة فنية مستقلة. صفِّ النتائج حسب التطبيق.',
    filters:[['all','الكل'],['seydel','سيدل والألياف والغزل'],['baski','أسطوانات الطباعة'],['servis','الخدمة']],
    mat:{ 'Rubber':'مطاط', 'Polyurethane':'بولي يوريثان', 'Ceramic/Chrome':'سيراميك / كروم', 'Service':'خدمة' },
    review:'استعرض',
    linesEy:'خطوط المنتجات', linesH:'علامتان ومعيار جودة واحد',
    tableH:'أسطوانات سيدل — جدول الأنواع', tableU:'(مم)',
    th:['النوع','القطر الخارجي','القطر الداخلي','الطول'],
    tableNote:'يعرض هذا الجدول المقاسات المرجعية لأنواع سيدل القياسية. وننتج كذلك خارج هذه المقاسات بما يناسب ظروف تشغيلكم.',
    specEy:'مشترك في كل منتج', specH:'ما نقدّمه بشكل قياسي',
    common:[['ruler','Ø1200 × 7000 مم','أقصى قطر وطول للتكسية.'],['cpu','قلب فولاذي ST52','يُشغَّل على ماكينات CNC من فولاذ مسبوك خاص.'],['gauge','شور A حسب ظروف تشغيلكم','تُحدَّد الصلادة بحسب التطبيق وتبقى ثابتة أثناء العمل.'],['shield','ضمان 3 أشهر','ضد عيوب التصنيع.']],
    matrixEy:'دليل التطبيق', matrixH:'أي منتج لأي قطاع؟', matrixP:'القطاعات التي يُستخدَم فيها كل نوع من منتجاتنا غالبًا. اضغطوا على اسم القطاع لفتح صفحته المخصصة.',
