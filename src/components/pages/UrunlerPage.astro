// Not: 8 ürün türü eskiden sayfanın EN ALTINDAydı; artık hero'dan hemen sonra ve filtrelenebilir.
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
