    <!-- 5 · ÜRÜN × SEKTÖR MATRİSİ -->
    <section class="border-b border-steel-200 bg-steel-50">
      <div class="mx-auto max-w-7xl px-6 py-16">
        <p class="text-sm font-700 uppercase tracking-widest text-brand-red">{H.matrixEy}</p>
        <h2 class="mt-3 font-display text-3xl font-800 tracking-tight text-navy-900 sm:text-4xl">{H.matrixH}</h2>
        <p class="mt-4 max-w-2xl text-navy-500">{H.matrixP}</p>
        <div class="mt-10 border-t border-steel-200">
          {productTypes.map(p => (
            <div class="grid gap-3 border-b border-steel-200 py-5 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] md:gap-8">
              <a href={`${base}/urunler/${p.slug}/`} class="font-display font-700 text-navy-900 hover:text-brand-red">{p.name[lang]}</a>
              <div class="flex flex-wrap gap-2">
                {p.sectors.map(sn => { const s = sectorOf(sn); return s ? (
                  <a href={`${base}/sektorler/${s.slug}/`} class="border border-steel-300 bg-white px-3 py-1.5 text-xs font-600 text-navy-600 transition hover:border-navy-900 hover:text-navy-900">{s[lang]}</a>
                ) : null; })}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 6 · TEKNİK ÜSTÜNLÜKLER -->
    <section class="border-b border-steel-200 bg-white">
      <div class="mx-auto max-w-7xl px-6 py-16">
        <p class="text-sm font-700 uppercase tracking-widest text-brand-red">{H.featEy}</p>
        <h2 class="mt-3 font-display text-3xl font-800 tracking-tight text-navy-900 sm:text-4xl">{H.featH}</h2>
        <div class="mt-10 grid border-l border-t border-steel-200 [&>*]:border-b [&>*]:border-r [&>*]:border-steel-200 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
          {features.map(f => (
            <div data-reveal class="bg-white p-7 transition hover:bg-steel-50">
              <Icon name={f.icon} class="h-7 w-7 text-brand-red"/>
              <h3 class="mt-5 font-display text-lg font-700 text-navy-900">{f[lang]}</h3>
              <p class="mt-2 text-sm leading-relaxed text-navy-500">{f.d[lang]}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 7 · HİZMETLER -->
    <section class="border-b border-steel-200 bg-steel-50">
      <div class="mx-auto max-w-7xl px-6 py-16">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-sm font-700 uppercase tracking-widest text-brand-red">{H.servEy}</p>
            <h2 class="mt-3 font-display text-3xl font-800 tracking-tight text-navy-900 sm:text-4xl">{H.servH}</h2>
          </div>
          <a href={`${base}/hizmetler/`} class="inline-flex items-center gap-2 text-sm font-700 uppercase tracking-wider text-navy-900 hover:text-brand-red">{H.servAll} <Icon name="arrow" class="h-4 w-4"/></a>
        </div>
        <div class="mt-10 grid border-l border-t border-steel-200 [&>*]:border-b [&>*]:border-r [&>*]:border-steel-200 sm:grid-cols-2 lg:grid-cols-4">
          {services.map(s => (
            <div class="bg-white p-6"><div class="mb-3 h-1 w-10 bg-brand-red"></div><h3 class="font-display font-700 text-navy-900">{s[lang]}</h3><p class="mt-1.5 text-sm leading-relaxed text-navy-500">{s.d[lang]}</p></div>
          ))}
        </div>
      </div>
    </section>

    <!-- 8 · PORTFÖY KATEGORİLERİ -->
    <section class="border-b border-steel-200 bg-white">
      <div class="mx-auto max-w-7xl px-6 py-16">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-sm font-700 uppercase tracking-widest text-brand-red">{H.galEy}</p>
            <h2 class="mt-3 font-display text-3xl font-800 tracking-tight text-navy-900 sm:text-4xl">{H.galH}</h2>
          </div>
          <a href={`${base}/galeri/`} class="inline-flex items-center gap-2 text-sm font-700 uppercase tracking-wider text-navy-900 hover:text-brand-red">{H.galAll} <Icon name="arrow" class="h-4 w-4"/></a>
        </div>
        <div class="mt-8 flex flex-wrap gap-2">
          {galleryCats.filter(c => c.key !== 'all').map(c => (
            <a href={`${base}/galeri/kategori/${c.key}/`} class="border border-steel-300 px-4 py-2.5 text-xs font-700 uppercase tracking-wider text-navy-600 transition hover:border-navy-900 hover:text-navy-900">{c[lang]}</a>
          ))}
        </div>
      </div>
    </section>

    <!-- 9 · SÖZLÜK -->
    <section class="border-b border-steel-200 bg-steel-50">
      <div class="mx-auto max-w-7xl px-6 py-16">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-sm font-700 uppercase tracking-widest text-brand-red">{H.glosEy}</p>
            <h2 class="mt-3 font-display text-3xl font-800 tracking-tight text-navy-900 sm:text-4xl">{H.glosH}</h2>
          </div>
          <a href={`${base}/sozluk/`} class="inline-flex items-center gap-2 text-sm font-700 uppercase tracking-wider text-navy-900 hover:text-brand-red">{H.glosAll} <Icon name="arrow" class="h-4 w-4"/></a>
        </div>
        <dl class="mt-10 grid border-l border-t border-steel-200 [&>*]:border-b [&>*]:border-r [&>*]:border-steel-200 sm:grid-cols-2 lg:grid-cols-3">
          {glossary.slice(0, 6).map(g => (
            <div class="bg-white p-6">
              <dt class="font-display font-700 text-navy-900">{g.term[lang]}</dt>
              <dd class="mt-2 text-sm leading-relaxed text-navy-500">{g.def[lang]}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- 10 · ÜRÜN SSS -->
    <section class="border-b border-steel-200 bg-white">
      <div class="mx-auto max-w-4xl px-6 py-16">
        <p class="text-sm font-700 uppercase tracking-widest text-brand-red">{H.faqEy}</p>
        <h2 class="mt-3 font-display text-3xl font-800 tracking-tight text-navy-900 sm:text-4xl">{H.faqH}</h2>
        <div id="pfaq" class="mt-8 border-t border-steel-200" data-accordion="collapse">
          {faqs.slice(0, 5).map((f, i) => (
            <Fragment>
              <h3 id={`ph-${i}`}><button type="button" class="flex w-full items-center justify-between gap-4 border-b border-steel-200 px-4 py-5 text-left font-display text-lg font-700 text-navy-900 hover:text-brand-red sm:px-5" data-active-classes="bg-steel-50 text-brand-red" data-inactive-classes="text-navy-900" data-accordion-target={`#pb-${i}`} aria-expanded={i===0} aria-controls={`pb-${i}`}><span>{f.q[lang]}</span><svg class="h-5 w-5 shrink-0 text-brand-red" data-accordion-icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg></button></h3>
              <div id={`pb-${i}`} class="hidden" aria-labelledby={`ph-${i}`}><p class="border-b border-steel-200 px-4 py-5 text-navy-600 sm:px-5">{f.a[lang]}</p></div>
            </Fragment>
          ))}
        </div>
        <div class="mt-8"><a href={`${base}/sss/`} class="group inline-flex items-center gap-2 border-2 border-navy-900 px-6 py-3.5 text-sm font-700 uppercase tracking-wider text-navy-900 transition hover:bg-navy-900 hover:text-white">{H.faqAll} <Icon name="arrow" class="h-4 w-4 transition group-hover:translate-x-1"/></a></div>
      </div>
    </section>

    <!-- 11 · CTA -->
    <ParallaxBand img="/gallery/murekkep-su-merdaneleri.webp" amount="26" overlay="base">
      <div class="mx-auto flex max-w-7xl flex-col items-start gap-8 px-6 py-16 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <h2 class="font-display text-2xl font-800 tracking-tight sm:text-3xl">{H.ctaH}</h2>
          <p class="mt-3 max-w-xl text-steel-300">{H.ctaP}</p>
        </div>
        <div class="flex shrink-0 flex-wrap gap-3">
          <a href={`${base}/teklif/`} class="inline-flex items-center gap-2 bg-brand-red px-6 py-4 text-sm font-700 uppercase tracking-wider transition hover:bg-white hover:text-navy-900">{H.quote} <Icon name="arrow" class="h-4 w-4"/></a>
          <a href={'tel:'+company.order.replace(/\s/g,'')} class="inline-flex items-center gap-2 border border-white/30 px-6 py-4 text-sm font-700 uppercase tracking-wider transition hover:bg-white/10"><Icon name="phone" class="h-4 w-4"/>{company.order}</a>
        </div>
      </div>
    </ParallaxBand>

    <RelatedLinks lang={lang} title={H.rel}
      items={H.relItems.map(([href, label, desc]) => ({ href: `${base}${href}`, label, desc }))} />
  </main>
  <Footer lang={lang} />
</Base>

<script is:inline>
  (function () {
    var bar = document.getElementById('pfilters');
    if (!bar) return;
    var btns = bar.querySelectorAll('[data-pf]');
    var cards = document.querySelectorAll('[data-pgroup]');
    bar.addEventListener('click', function (e) {
      var b = e.target.closest('[data-pf]');
      if (!b) return;
      var key = b.getAttribute('data-pf');
      btns.forEach(function (x) { x.setAttribute('aria-pressed', String(x === b)); });
      cards.forEach(function (c) {
        c.hidden = !(key === 'all' || c.getAttribute('data-pgroup') === key);
      });
    });
  })();
</script>
