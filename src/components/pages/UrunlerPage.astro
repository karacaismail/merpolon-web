      <div class="mx-auto max-w-7xl px-6 py-16">
        <div class="border border-steel-200">
          <div class="bg-navy-900 px-6 py-4"><h2 class="font-display font-700 text-white">{H.tableH} <span class="text-steel-400">{H.tableU}</span></h2></div>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead class="bg-steel-100 text-navy-600"><tr>{H.th.map(h => (<th scope="col" class="px-6 py-3 font-700">{h}</th>))}</tr></thead>
