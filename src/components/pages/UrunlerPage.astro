import PageHero from '../PageHero.astro';
import Icon from '../Icon.astro';
import RelatedLinks from '../RelatedLinks.astro';
import { productTypes, glossary } from '../../data/products';
import { productLines, seydelTypes, features, services, sectors, galleryCats, faqs, company } from '../../data/site';

const { lang = 'tr' } = Astro.props;
const base = lang === 'tr' ? '' : '/' + lang;
const SITE = (Astro.site ? Astro.site.href : '').replace(/\/$/, '');
const path = `${base}/urunler/`;

// Ürün türlerini uygulama grubuna göre ayır (malzeme tek başına kullanıcı için anlamlı bir eksen değil)
