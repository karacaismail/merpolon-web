    ctaH:'Visit our facility.', ctaBtn:'Contact',
  },
  de: {
    title:'Produktion & Werk — Merpolon | Merteks Elastomer',
    eyebrow:'Produktion & Werk',
    h1:'Im eigenen Werk,<br/>unter Ingenieuraufsicht',
    lede:'In unserem Werk im OIZ İkitelli führen wir den gesamten Prozess — von der Stahlkernfertigung über die Beschichtung bis zu Schleifen und Qualitätskontrolle — unter einem Dach. Laufende Maschinen- und F&E-Investitionen sichern hohe Qualität zu einem fairen Preis.',
    imgAlt:'Produktion',
    caps:[
      ['Ø1200 × 7000 mm','Max. Beschichtungsgröße'],
      ['ST52','Speziallegierter Stahlkern'],
      ['CNC','Präzisionsbearbeitung'],
      ['Labor','Eigene Gummiformel'],
    ],
    capEy:'Kompetenzen', capH:'Maschinenpark & Kompetenzen',
    capP:'Rebreaker-, Streck- und Finisherwalzen fertigen wir auf unseren Pressen mit Sonderformen. Walzen, deren Standzeit selbst nach dem Präzisionsschleifen lang bleibt.',
    capList:['CNC-Drehen & Schleifen','Hobelmaschine','Gummibeschichtung & Vulkanisation','Polyurethan-Guss','Gerad- / konisches / balliges Schleifen','Rauten- & Wendelrillen','Härte- (Shore A) & Wuchtprüfung','Sonderform- & Pressenfertigung','Neubeschichtung'],
    prEy:'Prozess', prH:'Produktion in fünf Schritten',
    galEy:'Galerie', galH:'Aus unserer Fertigung',
    galCaps:['Finisherwalze','Gummi-Seydel','Polyurethan-Seydel','Verschiedene Härten & Durchmesser'],
    galNote:'Werks- und Produktionsfotos folgen in Kürze.',
    ctaH:'Besuchen Sie unser Werk.', ctaBtn:'Kontakt',
  },
  ru: {
    title:'Производство и завод — Merpolon | Merteks Elastomer',
    eyebrow:'Производство и завод',
    h1:'На собственном заводе,<br/>под контролем инженера',
    lede:'На нашем предприятии в ОПЗ Икителли мы ведём весь процесс под одной крышей — от изготовления стального сердечника до покрытия, от шлифования до контроля качества. Постоянные инвестиции в оборудование и НИОКР обеспечивают высокое качество по доступной цене.',
    imgAlt:'Производство',
    caps:[
      ['Ø1200 × 7000 мм','Максимальный размер покрытия'],
      ['ST52','Сердечник из легированной стали'],
      ['CNC','Прецизионная механообработка'],
      ['Лаборатория','Собственная рецептура резины'],
    ],
    capEy:'Компетенции', capH:'Станочный парк и возможности',
    capP:'Валы rebreaker, тянущие и финишные мы изготавливаем на собственных прессах в специальных формах. Цилиндры, срок службы которых остаётся долгим даже после прецизионного шлифования.',
    capList:['Токарная обработка и шлифование на ЧПУ','Строгальный станок','Резиновое покрытие и вулканизация','Литьё полиуретана','Цилиндрическое / коническое / бомбированное шлифование','Нарезка ромбических и винтовых канавок','Контроль твёрдости (Shore A) и балансировки','Изготовление спецформ и прессование','Перепокрытие'],
    prEy:'Процесс', prH:'Производство в пять шагов',
