    h1:"شريككم في تطوير<br/>الأسطوانات <span class='text-brand-redlite'>المكسوّة</span>",
    lede:'أسطوانات سيدل مكسوّة بالمطاط والبولي يوريثان. أسطح لا تحتفظ بالحرارة، ومضادة للكهرباء الساكنة، وبصلادة ثابتة؛ تكسية وجلخ دقيق وفتح أخاديد حتى Ø1200 × 7000 مم.',
    cta1:'المنتجات', cta2:'معرض الأعمال',
    caps:['أسطوانات تغذية بولي يوريثان','إنتاج أسطوانات البولي يوريثان','أسطوانات مطاطية جرافيتية','طقم أسطوانات مكسوّة بالمطاط','أسطوانة تشطيب مكسوّة بالمطاط'],
    spec:['التأسيس','أقصى تكسية','قطاعًا','الضمان'], warranty:'3 أشهر',
    trust:'يثقون بنا',
    posEy:'Merteks Elastomer',
    pos:'بفضل المواد الكيميائية الخاصة التي نضيفها إلى الخلطة وتقنية اللصق التي طوّرناها بأنفسنا، ننتج أسطوانات <span class="text-brand-red">لا تحتفظ بالحرارة ولا تتكهرب وتحافظ على صلادتها طوال فترة العمل</span>.',
    about:'من نحن',
    whyEy:'لماذا Merpolon', whyH:'ثلاثة أسس يظهر أثرها في الميدان',
    pillars:[
      ['تركيبة قائمة على البحث والتطوير','مواد كيميائية خاصة في الخلطة وتقنية لصق من تطويرنا تمنح تكسيات لا تحتبس الحرارة ولا تتراكم عليها الكهرباء الساكنة.'],
      ['تصنيع متكامل','من القلب الفولاذي ST52 إلى التكسية، ومن الجلخ الدقيق إلى فتح الأخاديد — العملية كاملة تحت سقف واحد وبإشراف هندسي.'],
      ['إنتاج حسب مقاسكم','الصلادة (شور A) والقطر والطول وفق ظروف تشغيلكم، حتى Ø1200 × 7000 مم. وضمان ثلاثة أشهر ضد عيوب التصنيع.'],
    ],
    techEy:'المزايا الفنية', techH:'تركيبة تكسية مطوَّرة بالبحث والتطوير',
    matEy:'اختيار المادة', matH:'مطاط أم بولي يوريثان؟', matP:'نحدّد المادة الأنسب معًا بحسب تطبيقكم. مقارنة عامة:',
    compare:[
      ['المادة','مطاط (إيلاستومر)','بولي يوريثان (PU)'],
      ['القوة البارزة','مضاد للكهرباء الساكنة، لا يحتفظ بالحرارة','مقاومة التآكل والتمزّق'],
      ['سلوك الصلادة','ثابتة طوال العمل (SHA)','ارتداد مرن عالٍ وصلادة ثابتة'],
      ['الاستخدام النموذجي','أسطوانات القطع / التحويل','أسطوانات السحب / التشطيب'],
      ['القطاع','النسيج، الألياف والغزل، الورق','الألياف والغزل، التغليف، المعادن'],
    ],
    plEy:'خطوط المنتجات', plH:'علامتان ومعيار جودة واحد',
    pl1:'أسطوانات سيدل المطاطية', pl1b:['لا تحتفظ بالحرارة','مضادة للكهرباء الساكنة','صلادة ثابتة (SHA)','التصاق مثالي بالمعدن'],
    pl2:'أسطوانات سيدل البولي يوريثانية', pl2b:['مقاومة تآكل فائقة','مقاومة للتمزّق','تطرد حرارة التشغيل','مضبوطة مختبريًا'],
    metrics:['سنة خبرة','قطاعًا نخدمه','أقصى قطر (مم)','أقصى طول (مم)'],
    prEy:'عملية الإنتاج', prH:'من الفولاذ إلى الميدان في خمس خطوات',
    capEy:'الإنتاج والخدمة', capH:'دورة كاملة في منشأتنا',
    capP:'من تصنيع القلب الفولاذي ST52 بإشراف هندسي إلى التكسية، ومن الجلخ الدقيق إلى فتح الأخاديد — العملية كاملة تحت سقف واحد.',
    chips:['جلخ مستقيم','مخروطي','محدّب','أخدود معيّني','أخدود لولبي'],
    appEy:'التطبيق', appH:'لخطوط الألياف والغزل الأكريليكي',
    appP:'أسطوانات القطع والتحويل لآلات TWO / NSC / Seydel؛ وأسطوانات الريبريكر والسحب والتشطيب. وتُنتَج صلادات المطاط وأقطار التكسية مطابقة تمامًا لظروف تشغيلكم — ويبقى عمر التشغيل طويلًا حتى بعد الجلخ الدقيق.',
    sectors:'القطاعات',
    qEy:'وعد الجودة', qH:'الجودة والثقة هما عملنا',
    indH:`حلول لـ ${n} قطاعًا`, all:'عرض الكل',
    quote:'«بفضل تقنية اللصق الخاصة لدينا أنهينا مشكلة الانفصال عن المعدن. وبخبرة تتجاوز 25 عامًا نقدّم المعيار نفسه في كل أسطوانة.»',
    refEy:'المراجع', refH:'خيار المصانع في عموم تركيا',
    faqEy:'الأسئلة الشائعة', faqAll:'كل الأسئلة',
    exp:'اكتشفوا', explore:'استعرض',
    links:[
      ['أسطوانات المطاط والبولي يوريثان','أسطوانات سيدل من Merteks وMerpolon، وجدول الأنواع والمواصفات الفنية.'],
      ['التكسية والجلخ وفتح الأخاديد','تكسية حتى Ø1200 × 7000 مم، وجلخ دقيق وإعادة تكسية.'],
      [`حلول لـ ${n} قطاعًا`,'تطبيقات الأسطوانات في النسيج والطباعة والتغليف والصناعات الثقيلة.'],
      ['الإنتاج والمنشأة','قلب فولاذي ST52 وماكينات CNC ومقاشط، وتصنيع بإشراف هندسي.'],
      ['الجودة وضمان 3 أشهر','فحص الصلادة (شور A) والاتزان، وتركيبة تكسية قائمة على البحث والتطوير.'],
      ['المراجع ونطاق الخدمة','خيار منتجي النسيج والصناعة في أكثر من 15 محافظة.'],
    ],
    ctaH:'لنحدّد الأسطوانة المناسبة لمشروعكم.',
    ctaP:`اطلبوا عرض سعر للصلادة والقطر والتكسية المناسبة لظروف تشغيلكم — من أي مكان في تركيا، ${company.phone}.`,
    email:'البريد الإلكتروني',
  },
}[lang];

const slideSrc = [
  '/gallery/poliuretan-kapli-besleme-merdaneleri.webp',
  '/gallery/poliuretan-merdane-uretimi.webp',
  '/gallery/grafit-kaucuk-merdaneler.webp',
  '/gallery/kaucuk-kapli-merdane-seti.webp',
  '/gallery/kaucuk-kapli-finisor-merdanesi.webp',
];
const heroSlides = slideSrc.map((src, i) => ({ src, caption: H.caps[i] }));
const crossHrefs = ['/urunler/','/hizmetler/','/sektorler/','/uretim/','/kalite/','/referanslar/'];
---
<Base title={H.title} lang={lang} path={lang === 'tr' ? '/' : `/${lang}/`}>
  <Header lang={lang} />
  <main id="main" class="bg-white">

    <!-- 1 · HERO SLIDER -->
    <HeroSlider
      eyebrow={H.eyebrow}
      title={H.h1}
      lede={H.lede}
      cta1={{ href:`${base}/urunler/`, label:H.cta1 }}
      cta2={{ href:`${base}/galeri/`, label:H.cta2 }}
      slides={heroSlides}
    />

    <!-- 2 · SPEC STRIP -->
    <section class="border-b border-steel-200 bg-steel-50">
      <div class="mx-auto grid max-w-7xl grid-cols-2 divide-x divide-steel-200 lg:grid-cols-4">
        {[['1989',H.spec[0]],['Ø1200 × 7000 mm',H.spec[1]],[String(n),H.spec[2]],[H.warranty,H.spec[3]]].map(([v,l]) => (
          <div class="px-6 py-8"><div class="font-display text-2xl font-800 text-navy-900">{v}</div><div class="mt-1 text-xs uppercase tracking-wider text-navy-500">{l}</div></div>
        ))}
      </div>
    </section>

    <!-- 3 · TRUST MARQUEE -->
    <section class="overflow-hidden border-b border-steel-200 py-6">
      <div class="flex items-center gap-3 px-6 text-xs font-700 uppercase tracking-widest text-navy-400"><span class="whitespace-nowrap">{H.trust}</span>
        <div class="relative flex flex-1 overflow-hidden [mask-image:linear-gradient(90deg,transparent,#000_8%,#000_92%,transparent)]">
          <div class="flex shrink-0 animate-marquee items-center gap-10 pr-10">
            {[...references, ...references].map(r => (<span class="whitespace-nowrap font-display text-base font-700 text-navy-300">{r.split('—')[0].trim()}</span>))}
          </div>
        </div>
      </div>
    </section>

    <!-- 4 · POSITIONING -->
    <section class="mx-auto max-w-4xl px-6 py-20 lg:py-28" data-reveal-group>
      <p data-reveal class="text-sm font-700 uppercase tracking-widest text-brand-red">{H.posEy}</p>
      <p data-reveal class="mt-6 font-display text-2xl font-600 leading-snug tracking-tight text-navy-900 sm:text-3xl lg:text-[2.1rem] lg:leading-[1.3]" set:html={H.pos}></p>
      <div data-reveal class="mt-8"><a href={`${base}/kurumsal/`} class="inline-flex items-center gap-2 text-sm font-700 uppercase tracking-wider text-navy-900 hover:text-brand-red">{H.about} <Icon name="arrow" class="h-4 w-4"/></a></div>
    </section>

    <!-- 5 · WHY / PILLARS -->
    <section class="border-y border-steel-200 bg-navy-900 text-white">
      <div class="mx-auto max-w-7xl px-6 py-20 lg:py-24">
        <div class="max-w-2xl" data-reveal-group>
          <p data-reveal class="text-sm font-700 uppercase tracking-widest text-brand-redlite">{H.whyEy}</p>
          <h2 data-reveal class="mt-3 font-display text-3xl font-800 tracking-tight sm:text-4xl">{H.whyH}</h2>
        </div>
        <div class="mt-14 grid border-l border-t border-white/10 [&>*]:border-b [&>*]:border-r [&>*]:border-white/10 sm:grid-cols-3" data-reveal-group>
          {H.pillars.map(([t, d], i) => (
            <div data-reveal class="bg-navy-900 p-8">
              <div class="font-display text-5xl font-800 text-white/15">{'0' + (i + 1)}</div>
              <h3 class="mt-6 font-display text-xl font-700">{t}</h3>
              <p class="mt-3 text-sm leading-relaxed text-steel-400">{d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 6 · TECHNICAL ADVANTAGES -->
    <section class="mx-auto max-w-7xl px-6 py-20 lg:py-24">
      <div class="max-w-2xl" data-reveal-group>
        <p data-reveal class="text-sm font-700 uppercase tracking-widest text-brand-red">{H.techEy}</p>
        <h2 data-reveal class="mt-3 font-display text-3xl font-800 tracking-tight text-navy-900 sm:text-4xl">{H.techH}</h2>
      </div>
      <div class="mt-12 grid border-l border-t border-steel-200 [&>*]:border-b [&>*]:border-r [&>*]:border-steel-200 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
        {features.map(f => (
          <div data-reveal class="group bg-white p-7 transition hover:bg-steel-50">
            <Icon name={f.icon} class="h-7 w-7 text-brand-red"/>
            <h3 class="mt-5 font-display text-lg font-700 text-navy-900">{f[lang]}</h3>
            <p class="mt-2 text-sm leading-relaxed text-navy-500">{f.d[lang]}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 7 · MATERIAL SELECTOR -->
    <section class="border-y border-steel-200 bg-steel-50">
      <div class="mx-auto max-w-7xl px-6 py-20 lg:py-24">
        <div class="max-w-2xl" data-reveal-group>
          <p data-reveal class="text-sm font-700 uppercase tracking-widest text-brand-red">{H.matEy}</p>
          <h2 data-reveal class="mt-3 font-display text-3xl font-800 tracking-tight text-navy-900 sm:text-4xl">{H.matH}</h2>
          <p data-reveal class="mt-4 text-navy-500">{H.matP}</p>
        </div>
        <!-- masaüstü: tablo -->
        <div class="mt-10 hidden overflow-hidden border border-steel-200 bg-white md:block" data-reveal>
          <table class="w-full text-left text-sm">
            <tbody>
              {H.compare.map((row, i) => (
                <tr class={i===0 ? 'bg-navy-900 text-white' : 'border-t border-steel-200'}>
                  <td class={`px-6 py-4 font-700 ${i===0 ? '' : 'text-navy-500'}`}>{row[0]}</td>
                  <td class={`px-6 py-4 ${i===0 ? 'font-800' : 'font-600 text-navy-900'}`}>{row[1]}</td>
                  <td class={`px-6 py-4 ${i===0 ? 'font-800' : 'font-600 text-navy-900'}`}>{row[2]}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <!-- mobil: akordiyon -->
        <div id="cmp" class="mt-8 border-t border-steel-200 md:hidden" data-accordion="collapse">
          {H.compare.slice(1).map((row, i) => (
            <Fragment>
              <h3 id={`ch-${i}`}><button type="button" class="flex w-full items-center justify-between gap-3 border-b border-steel-200 bg-white px-4 py-4 text-left font-display font-700 text-navy-900" data-active-classes="bg-steel-50 text-brand-red" data-inactive-classes="text-navy-900" data-accordion-target={`#cb-${i}`} aria-expanded={i===0} aria-controls={`cb-${i}`}><span>{row[0]}</span><svg class="h-5 w-5 shrink-0 text-brand-red" data-accordion-icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg></button></h3>
              <div id={`cb-${i}`} class="hidden" aria-labelledby={`ch-${i}`}>
                <div class="border-b border-steel-200 bg-steel-50 px-4 py-4 text-sm">
                  <div class="flex justify-between gap-4 border-b border-steel-200 py-2"><span class="font-700 text-brand-red">{H.compare[0][1]}</span><span class="text-right font-600 text-navy-900">{row[1]}</span></div>
                  <div class="flex justify-between gap-4 py-2"><span class="font-700 text-navy-900">{H.compare[0][2]}</span><span class="text-right font-600 text-navy-900">{row[2]}</span></div>
                </div>
              </div>
            </Fragment>
          ))}
        </div>
      </div>
    </section>

    <!-- 8 · PRODUCT LINES -->
    <section class="mx-auto max-w-7xl px-6 py-20 lg:py-24">
      <div class="max-w-2xl" data-reveal-group>
        <p data-reveal class="text-sm font-700 uppercase tracking-widest text-brand-red">{H.plEy}</p>
        <h2 data-reveal class="mt-3 font-display text-3xl font-800 tracking-tight text-navy-900 sm:text-4xl">{H.plH}</h2>
      </div>
      <div class="mt-14 space-y-16">
        <article class="grid items-center gap-10 lg:grid-cols-2" data-reveal-group>
          <div data-reveal class="overflow-hidden border border-steel-200"><img data-reveal-img src="/gallery/grafit-kaucuk-merdaneler.webp" srcset="/gallery/grafit-kaucuk-merdaneler-480.webp 480w, /gallery/grafit-kaucuk-merdaneler-960.webp 960w, /gallery/grafit-kaucuk-merdaneler.webp 1500w" sizes="(max-width: 768px) 100vw, 50vw" alt={H.pl1} width="1063" height="750" class="aspect-[4/3] w-full object-cover"/></div>
          <div data-reveal>
            <div class="flex items-center gap-3"><span class="h-2.5 w-2.5 bg-brand-red"></span><span class="font-display text-sm font-800 uppercase tracking-widest text-brand-red">Merteks</span></div>
            <h3 class="mt-4 font-display text-2xl font-800 text-navy-900">{H.pl1}</h3>
            <p class="mt-4 leading-relaxed text-navy-500">{productLines[0].body[lang]}</p>
            <ul class="mt-6 grid gap-x-6 gap-y-2 sm:grid-cols-2">{H.pl1b.map(x => (<li class="flex items-center gap-2 text-sm text-navy-700"><Icon name="check" class="h-4 w-4 shrink-0 text-brand-red"/>{x}</li>))}</ul>
          </div>
        </article>
        <article class="grid items-center gap-10 lg:grid-cols-2" data-reveal-group>
          <div data-reveal class="lg:order-2 overflow-hidden border border-steel-200"><img data-reveal-img src="/gallery/poliuretan-kapli-besleme-merdaneleri.webp" srcset="/gallery/poliuretan-kapli-besleme-merdaneleri-480.webp 480w, /gallery/poliuretan-kapli-besleme-merdaneleri-960.webp 960w, /gallery/poliuretan-kapli-besleme-merdaneleri.webp 1500w" sizes="(max-width: 768px) 100vw, 50vw" alt={H.pl2} width="764" height="485" class="aspect-[4/3] w-full object-cover"/></div>
          <div data-reveal class="lg:order-1">
            <div class="flex items-center gap-3"><span class="h-2.5 w-2.5 bg-navy-900"></span><span class="font-display text-sm font-800 uppercase tracking-widest text-navy-900">Merpolon</span></div>
            <h3 class="mt-4 font-display text-2xl font-800 text-navy-900">{H.pl2}</h3>
            <p class="mt-4 leading-relaxed text-navy-500">{productLines[1].body[lang]}</p>
            <ul class="mt-6 grid gap-x-6 gap-y-2 sm:grid-cols-2">{H.pl2b.map(x => (<li class="flex items-center gap-2 text-sm text-navy-700"><Icon name="check" class="h-4 w-4 shrink-0 text-brand-red"/>{x}</li>))}</ul>
          </div>
        </article>
      </div>
    </section>

    <!-- 9 · METRICS BAND -->
    <section class="relative overflow-hidden bg-navy-900 text-white">
      <img data-parallax="26" src="/gallery/kaucuk-kapli-merdane-seti.webp" srcset="/gallery/kaucuk-kapli-merdane-seti-480.webp 480w, /gallery/kaucuk-kapli-merdane-seti-960.webp 960w, /gallery/kaucuk-kapli-merdane-seti.webp 1280w" sizes="100vw" alt="" width="1500" height="1000" class="absolute -top-[70%] left-0 h-[240%] w-full object-cover opacity-20"/>
      <div class="relative mx-auto grid max-w-7xl grid-cols-2 divide-x divide-white/10 px-6 py-16 lg:grid-cols-4" data-reveal-group>
        <div data-reveal class="px-4 text-center"><div class="font-display text-4xl font-800 sm:text-5xl"><span data-count="25" data-suffix="+">0</span></div><div class="mt-2 text-xs uppercase tracking-wider text-steel-400">{H.metrics[0]}</div></div>
        <div data-reveal class="px-4 text-center"><div class="font-display text-4xl font-800 sm:text-5xl"><span data-count={n}>0</span></div><div class="mt-2 text-xs uppercase tracking-wider text-steel-400">{H.metrics[1]}</div></div>
        <div data-reveal class="px-4 text-center"><div class="font-display text-4xl font-800 sm:text-5xl"><span data-count="1200" data-prefix="Ø">0</span></div><div class="mt-2 text-xs uppercase tracking-wider text-steel-400">{H.metrics[2]}</div></div>
        <div data-reveal class="px-4 text-center"><div class="font-display text-4xl font-800 sm:text-5xl"><span data-count="7000">0</span></div><div class="mt-2 text-xs uppercase tracking-wider text-steel-400">{H.metrics[3]}</div></div>
      </div>
    </section>

    <!-- 10 · PROCESS -->
    <section class="mx-auto max-w-7xl px-6 py-20 lg:py-24">
      <div class="max-w-2xl" data-reveal-group>
        <p data-reveal class="text-sm font-700 uppercase tracking-widest text-brand-red">{H.prEy}</p>
        <h2 data-reveal class="mt-3 font-display text-3xl font-800 tracking-tight text-navy-900 sm:text-4xl">{H.prH}</h2>
      </div>
      <div class="mt-12 grid border-l border-t border-steel-200 [&>*]:border-b [&>*]:border-r [&>*]:border-steel-200 md:grid-cols-5" data-reveal-group>
        {process.map(s => (
          <div data-reveal class="bg-white p-6">
            <div class="flex items-center justify-between"><span class="font-display text-3xl font-800 text-steel-300">{s.no}</span><Icon name={s.icon} class="h-5 w-5 text-brand-red"/></div>
            <h3 class="mt-5 font-display font-700 text-navy-900">{s[lang]}</h3>
            <p class="mt-2 text-sm leading-relaxed text-navy-500">{s.d[lang]}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- 11 · CAPABILITIES -->
    <section class="border-y border-steel-200 bg-steel-50">
      <div class="mx-auto max-w-7xl px-6 py-20 lg:py-24">
        <div class="grid gap-12 lg:grid-cols-[1fr_1.3fr] lg:gap-20">
          <div data-reveal-group>
            <p data-reveal class="text-sm font-700 uppercase tracking-widest text-brand-red">{H.capEy}</p>
            <h2 data-reveal class="mt-3 font-display text-3xl font-800 tracking-tight text-navy-900 sm:text-4xl">{H.capH}</h2>
            <p data-reveal class="mt-5 leading-relaxed text-navy-500">{H.capP}</p>
            <div data-reveal class="mt-6 flex flex-wrap gap-2">{H.chips.map(x => (<span class="border border-steel-300 px-3 py-1.5 text-xs font-600 text-navy-600">{x}</span>))}</div>
          </div>
          <div class="divide-y divide-steel-200 border-t border-steel-200" data-reveal-group>
            {services.map((s, i) => (
              <div data-reveal class="group flex items-start gap-6 py-6">
                <span class="font-display text-sm font-800 text-steel-300">0{i+1}</span>
                <div class="flex-1"><h3 class="font-display text-lg font-700 text-navy-900 transition group-hover:text-brand-red">{s[lang]}</h3><p class="mt-1 text-sm text-navy-500">{s.d[lang]}</p></div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 12 · APPLICATION SPOTLIGHT -->
    <section class="mx-auto max-w-7xl px-6 py-20 lg:py-24">
      <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
        <div data-reveal class="overflow-hidden border border-steel-200"><img data-reveal-img src="/gallery/poliuretan-merdane-uretimi.webp" srcset="/gallery/poliuretan-merdane-uretimi-480.webp 480w, /gallery/poliuretan-merdane-uretimi-960.webp 960w, /gallery/poliuretan-merdane-uretimi.webp 1500w" sizes="(max-width: 768px) 100vw, 50vw" alt={H.appH} width="832" height="666" class="aspect-[5/4] w-full object-cover"/></div>
        <div data-reveal-group>
          <p data-reveal class="text-sm font-700 uppercase tracking-widest text-brand-red">{H.appEy}</p>
          <h2 data-reveal class="mt-3 font-display text-3xl font-800 tracking-tight text-navy-900 sm:text-4xl">{H.appH}</h2>
          <p data-reveal class="mt-5 leading-relaxed text-navy-500">{H.appP}</p>
          <a data-reveal href={`${base}/sektorler/`} class="mt-7 inline-flex items-center gap-2 text-sm font-700 uppercase tracking-wider text-navy-900 hover:text-brand-red">{H.sectors} <Icon name="arrow" class="h-4 w-4"/></a>
        </div>
      </div>
    </section>

    <!-- 13 · QUALITY PROMISE -->
    <section class="border-y border-steel-200 bg-steel-50">
      <div class="mx-auto max-w-7xl px-6 py-20 lg:py-24">
        <div class="max-w-2xl" data-reveal-group>
          <p data-reveal class="text-sm font-700 uppercase tracking-widest text-brand-red">{H.qEy}</p>
          <h2 data-reveal class="mt-3 font-display text-3xl font-800 tracking-tight text-navy-900 sm:text-4xl">{H.qH}</h2>
        </div>
        <div class="mt-12 grid gap-6 sm:grid-cols-3" data-reveal-group>
          {qualityPoints.slice(0,3).map(q => (
            <div data-reveal class="border-t-2 border-brand-red bg-white p-7">
              <Icon name={q.icon} class="h-7 w-7 text-navy-900"/>
              <h3 class="mt-5 font-display text-lg font-700 text-navy-900">{q[lang]}</h3>
              <p class="mt-2 text-sm leading-relaxed text-navy-500">{q.d[lang]}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 14 · INDUSTRIES -->
    <section class="mx-auto max-w-7xl px-6 py-20 lg:py-24">
      <div class="flex flex-wrap items-end justify-between gap-4" data-reveal-group>
        <div><p data-reveal class="text-sm font-700 uppercase tracking-widest text-brand-red">{H.sectors}</p><h2 data-reveal class="mt-3 font-display text-3xl font-800 tracking-tight text-navy-900 sm:text-4xl">{H.indH}</h2></div>
        <a data-reveal href={`${base}/sektorler/`} class="inline-flex items-center gap-2 text-sm font-700 uppercase tracking-wider text-navy-900 hover:text-brand-red">{H.all} <Icon name="arrow" class="h-4 w-4"/></a>
      </div>
      <div class="mt-12 grid grid-cols-2 border-l border-t border-steel-200 [&>*]:border-b [&>*]:border-r [&>*]:border-steel-200 sm:grid-cols-4" data-reveal-group>
        {sectors.map(s => (<a href={`${base}/sektorler/${s.slug}/`} data-reveal class="group flex items-center gap-3 bg-white px-5 py-6 transition hover:bg-navy-900"><Icon name={s.icon} class="h-5 w-5 shrink-0 text-brand-red"/><span class="text-sm font-600 text-navy-800 transition group-hover:text-white">{s[lang]}</span></a>))}
      </div>
    </section>

    <!-- 15 · QUOTE -->
    <ParallaxBand img="/gallery/isiya-dayanikli-kaucuk-merdane.webp" amount="26" overlay="strong">
      <div class="mx-auto max-w-4xl px-6 py-20 text-center" data-reveal>
        <div class="mx-auto mb-6 h-px w-12 bg-brand-red"></div>
        <p class="font-display text-2xl font-600 leading-snug tracking-tight sm:text-3xl">{H.quote}</p>
        <p class="mt-6 text-sm uppercase tracking-widest text-steel-400">Merteks Elastomer</p>
      </div>
    </ParallaxBand>

    <!-- 16 · REFERENCES -->
    <section class="mx-auto max-w-7xl px-6 py-20">
      <div class="grid gap-10 lg:grid-cols-[1fr_2fr] lg:items-center">
        <div data-reveal><p class="text-sm font-700 uppercase tracking-widest text-brand-red">{H.refEy}</p><h2 class="mt-3 font-display text-2xl font-800 tracking-tight text-navy-900 sm:text-3xl">{H.refH}</h2></div>
        <div class="grid grid-cols-2 border-l border-t border-steel-200 [&>*]:border-b [&>*]:border-r [&>*]:border-steel-200 sm:grid-cols-3" data-reveal-group>
          {references.map(r => { const [name, city] = r.split('—').map(x=>x.trim()); return (<div data-reveal class="bg-white px-5 py-6"><div class="font-display font-700 text-navy-900">{name}</div><div class="text-xs uppercase tracking-wider text-navy-500">{city}</div></div>); })}
        </div>
      </div>
    </section>

    <!-- 17 · FAQ -->
    <section class="border-t border-steel-200 bg-steel-50">
      <div class="mx-auto max-w-4xl px-6 py-20">
        <p class="text-sm font-700 uppercase tracking-widest text-brand-red" data-reveal>{H.faqEy}</p>
        <div id="faq" class="mt-8 border-t border-steel-200" data-accordion="collapse" data-reveal>
          {faqs.slice(0,6).map((f, i) => (
            <Fragment>
              <h3 id={`fh-${i}`}><button type="button" class="flex w-full items-center justify-between gap-4 border-b border-steel-200 px-4 py-5 text-left font-display text-lg font-700 text-navy-900 hover:text-brand-red sm:px-5" data-active-classes="bg-steel-50 text-brand-red" data-inactive-classes="text-navy-900" data-accordion-target={`#fb-${i}`} aria-expanded={i===0} aria-controls={`fb-${i}`}><span>{f.q[lang]}</span><svg class="h-5 w-5 shrink-0 text-brand-red" data-accordion-icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg></button></h3>
              <div id={`fb-${i}`} class="hidden" aria-labelledby={`fh-${i}`}><p class="border-b border-steel-200 px-4 py-5 text-navy-600 sm:px-5">{f.a[lang]}</p></div>
            </Fragment>
          ))}
        </div>
        <div class="mt-8" data-reveal><a href={`${base}/sss/`} class="group inline-flex items-center gap-2 border-2 border-navy-900 px-6 py-3.5 text-sm font-700 uppercase tracking-wider text-navy-900 transition hover:bg-navy-900 hover:text-white">{H.faqAll} <Icon name="arrow" class="h-4 w-4 transition group-hover:translate-x-1"/></a></div>
      </div>
    </section>

    <!-- 17.5 · CROSS-LINKS (SEO) -->
    <section class="border-t border-steel-200 bg-white">
      <div class="mx-auto max-w-7xl px-6 py-16">
        <p class="text-sm font-700 uppercase tracking-widest text-brand-red" data-reveal>{H.exp}</p>
        <div class="mt-8 grid border-l border-t border-steel-200 [&>*]:border-b [&>*]:border-r [&>*]:border-steel-200 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
          {H.links.map(([t,d], i) => (
            <a href={`${base}${crossHrefs[i]}`} data-reveal class="group flex flex-col bg-white p-7 transition hover:bg-steel-50">
              <h3 class="font-display text-lg font-700 text-navy-900 group-hover:text-brand-red">{t}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-navy-500">{d}</p>
              <span class="mt-4 inline-flex items-center gap-2 text-xs font-700 uppercase tracking-wider text-navy-900 group-hover:text-brand-red">{H.explore} <Icon name="arrow" class="h-4 w-4 transition group-hover:translate-x-1"/></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 18 · CTA -->
    <ParallaxBand img="/gallery/kaucuk-kapli-finisor-merdanesi.webp" amount="26" overlay="base">
      <div class="mx-auto flex max-w-7xl flex-col items-start gap-8 px-6 py-20 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <h2 class="font-display text-3xl font-800 tracking-tight sm:text-4xl">{H.ctaH}</h2>
          <p class="mt-4 max-w-xl text-steel-300">{H.ctaP}</p>
        </div>
        <div class="flex shrink-0 flex-wrap gap-3">
          <a href={'tel:'+company.order.replace(/\s/g,'')} class="inline-flex items-center gap-2 bg-brand-red px-6 py-4 text-sm font-700 uppercase tracking-wider transition hover:bg-white hover:text-navy-900"><Icon name="phone" class="h-4 w-4"/>{company.order}</a>
          <a href={'mailto:'+company.email} class="inline-flex items-center gap-2 border border-white/30 px-6 py-4 text-sm font-700 uppercase tracking-wider transition hover:bg-white/10">{H.email}</a>
        </div>
      </div>
    </ParallaxBand>

  </main>
  <Footer lang={lang} />
</Base>
