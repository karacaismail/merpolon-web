---
// İl bazlı hizmet sayfası (Local + Programmatic SEO).
// Dürüstlük notu: bu illerde şube YOK — İstanbul'daki tesisten sevkiyat yapılır. Metin bunu açıkça söyler.
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Icon from './Icon.astro';
import Breadcrumb from './Breadcrumb.astro';
import RelatedLinks from './RelatedLinks.astro';
import { company, services, coverage } from '../data/site';
import { productTypes } from '../data/products';

const { city, lang = 'tr' } = Astro.props;
const base = lang === 'tr' ? '' : '/' + lang;
const slug = city.slug;
const path = `${base}/merdane-kaplama/${slug}/`;
const name = city.name;
const SITE = (Astro.site ? Astro.site.href : '').replace(/\/$/, '');
const others = coverage.filter(c => c !== name).slice(0, 3);
const trSlug = (s) => s.toLocaleLowerCase('tr').replace(/ı/g,'i').replace(/ç/g,'c').replace(/ğ/g,'g').replace(/ö/g,'o').replace(/ş/g,'s').replace(/ü/g,'u').replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');

const h1 = `${name} merdane kaplama ve yeniden kaplama`;
const desc = `${name} ve çevresindeki tesisler için kauçuk ve poliüretan merdane kaplama, hassas taşlama ve yeniden kaplama. İstanbul İOSB'deki tesisimizden ${name}'e sevkiyat, Ø1200 × 7000 mm'e kadar üretim.`;

const schema = [{
  '@type':'Service', '@id': `${SITE}${path}#service`,
  name: h1, description: desc,
  serviceType: 'Merdane kaplama',
  provider: { '@id': `${SITE}/#organization` },
  areaServed: { '@type':'City', name, containedInPlace: { '@type':'Country', name:'Türkiye' } },
  availableChannel: { '@type':'ServiceChannel', servicePhone: '+905559869754', serviceUrl: `${SITE}${path}` },
}];
---
<Base title={`${h1} | Merpolon`} lang={lang} path={path} description={desc} schema={schema} alts={['tr']}>
  <Header lang={lang} />
  <Breadcrumb lang={lang} items={[{ href:`${base}/hizmetler/`, label:'Hizmetler' }, { href:path, label:name }]} />
  <main id="main" class="bg-white">
    <section class="border-b border-steel-200">
      <div class="mx-auto max-w-7xl px-6 py-14 lg:py-20">
        <p class="flex items-center gap-3 text-xs font-700 uppercase tracking-[0.22em] text-brand-red"><span class="h-px w-10 bg-brand-red"></span>Hizmet bölgesi · {name}</p>
        <h1 class="mt-5 max-w-3xl font-display text-3xl font-800 leading-[1.06] tracking-tight text-navy-900 sm:text-5xl">{h1}</h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-navy-500">{desc}</p>
        <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
          <a href={`${base}/teklif/`} class="group inline-flex items-center gap-2.5 bg-brand-red px-7 py-4 text-sm font-700 uppercase tracking-wider text-white transition hover:bg-navy-900">Teklif Formu <Icon name="arrow" class="h-4 w-4 transition group-hover:translate-x-1"/></a>
          <a href={'tel:'+company.order.replace(/\s/g,'')} class="inline-flex items-center gap-2 border-b-2 border-navy-900 pb-1 text-sm font-700 uppercase tracking-wider text-navy-900 transition hover:border-brand-red hover:text-brand-red">{company.order}</a>
        </div>
      </div>
    </section>

    <section class="border-b border-steel-200 bg-steel-50">
      <div class="mx-auto max-w-4xl px-6 py-10">
        <div class="border-l-2 border-brand-red bg-white p-5">
          <h2 class="font-display text-sm font-800 uppercase tracking-widest text-brand-red">Nasıl çalışıyoruz?</h2>
          <p class="mt-3 leading-relaxed text-navy-700">Üretimimiz İstanbul İOSB Esenler Sanayi Sitesi'ndeki tesisimizde yapılır; <strong>{name}</strong>'de şubemiz bulunmaz. Merdanenizi kargo ile gönderirsiniz, ölçü ve sertlik tespiti sonrası kaplar, taşlar, balans kontrolünden geçirir ve size geri göndeririz. Yeni üretim siparişlerinde de sevkiyat aynı şekilde ilerler.</p>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 py-14">
      <h2 class="font-display text-2xl font-800 tracking-tight text-navy-900">{name} için hizmetlerimiz</h2>
      <div class="mt-8 grid border-l border-t border-steel-200 [&>*]:border-b [&>*]:border-r [&>*]:border-steel-200 sm:grid-cols-2 lg:grid-cols-4">
        {services.map(s => (
          <div class="bg-white p-6">
            <h3 class="font-display font-700 text-navy-900">{s.tr}</h3>
            <p class="mt-2 text-sm leading-relaxed text-navy-500">{s.d.tr}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="border-y border-steel-200 bg-steel-50">
      <div class="mx-auto max-w-7xl px-6 py-14">
        <h2 class="font-display text-2xl font-800 tracking-tight text-navy-900">{name}'e gönderdiğimiz ürünler</h2>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {productTypes.slice(0,4).map(p => (
            <a href={`${base}/urunler/${p.slug}/`} class="group border border-steel-200 bg-white transition hover:border-brand-red/40">
              <img src={p.img} alt={p.name.tr} loading="lazy" width="1500" height="1000" class="aspect-[4/3] w-full object-cover" />
              <div class="p-5"><h3 class="font-display text-base font-700 text-navy-900 group-hover:text-brand-red">{p.name.tr}</h3></div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <RelatedLinks lang={lang} title="Diğer hizmet bölgeleri"
      items={others.map(c => ({ href:`${base}/merdane-kaplama/${trSlug(c)}/`, label:`${c} merdane kaplama`, desc:`${c} ve çevresine kauçuk/poliüretan merdane kaplama ve yeniden kaplama.` }))} />
  </main>
  <Footer lang={lang} />
</Base>
