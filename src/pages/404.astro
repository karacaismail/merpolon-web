---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { nav, footerExtra } from '../data/site';
const lang = 'tr';
const links = [...nav[lang], ...footerExtra[lang]];
---
<Base title="Sayfa bulunamadı (404) | Merpolon" lang={lang} path="/404/" description="Aradığınız sayfa bulunamadı. Ürünler, sektörler, hizmetler ve iletişim sayfalarından devam edebilirsiniz.">
  <Header lang={lang} />
  <main id="main" class="bg-white">
    <section class="mx-auto max-w-4xl px-6 py-20 lg:py-28">
      <p class="font-display text-6xl font-800 text-steel-300">404</p>
      <h1 class="mt-4 font-display text-3xl font-800 tracking-tight text-navy-900 sm:text-4xl">Aradığınız sayfa bulunamadı</h1>
      <p class="mt-4 max-w-xl text-lg leading-relaxed text-navy-500">Adres değişmiş veya sayfa kaldırılmış olabilir. Aşağıdaki bölümlerden devam edebilir ya da doğrudan teklif formuna gidebilirsiniz.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/teklif/" class="inline-flex items-center gap-2 bg-brand-red px-6 py-3.5 text-sm font-700 uppercase tracking-wider text-white transition hover:bg-navy-900">Teklif Formu <Icon name="arrow" class="h-4 w-4"/></a>
        <a href="/" class="inline-flex items-center gap-2 border-2 border-navy-900 px-6 py-3.5 text-sm font-700 uppercase tracking-wider text-navy-900 transition hover:bg-navy-900 hover:text-white">Ana Sayfa</a>
      </div>
      <div class="mt-10 flex flex-wrap items-center gap-2 border-t border-steel-200 pt-8">
        <span class="mr-1 text-xs font-700 uppercase tracking-wider text-navy-400">Language</span>
        {[['/','Türkçe','tr'],['/en/','English','en'],['/de/','Deutsch','de'],['/ru/','Русский','ru'],['/ar/','العربية','ar']].map(([h,l,c]) => (
          <a href={h} hreflang={c} lang={c} class="border border-steel-300 px-3.5 py-2 text-xs font-700 text-navy-600 transition hover:border-navy-900 hover:text-navy-900">{l}</a>
        ))}
      </div>
      <div class="mt-12 grid border-l border-t border-steel-200 [&>*]:border-b [&>*]:border-r [&>*]:border-steel-200 sm:grid-cols-2 lg:grid-cols-3">
        {links.map(([href,label]) => (<a href={href} class="bg-white px-5 py-4 text-sm font-600 text-navy-700 transition hover:bg-steel-50 hover:text-brand-red">{label}</a>))}
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</Base>
